        <div class="yh-display__beat" data-part="beat">
          <BarBeat beat=2 beats=4 thickness="var(--yh-display-beat-line)">
        <div class="lib-stack yh-display__tempo-keys" data-align="center" data-direction="row" data-gap="1" data-part="tempo-keys">
          <Button hold=true label="Tap" name="Tap tempo" size="md" tip="tempo.tap" @tipAction=tipAction @onHold=tapHold @onPress=tap>
          <Button disabled=false label="Style tempo" name="Back to the style's tempo" size="md" tip="tempo.reset" variant="quiet" @tipAction=tipAction @onPress=styleTempo>
