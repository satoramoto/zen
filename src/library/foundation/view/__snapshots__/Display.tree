  <div class="yh-display__frame" data-fit="1" data-part="frame" use:displayFit={"key":"[\"Sunday Drive Pop\",\"Pop & Rock · 4/4\",\"\",\"Main B\",104,\"Am\",\"7\",true,\"compact\"]"}>
    <header class="yh-display__header" data-part="header">
      <div aria-label="Style" class="lib-stack yh-display__style" data-align="center" data-direction="row" data-gap="1" data-part="style" role="group">
        <Button name="Previous style (Track left)" size="icon" symbol="prev" tip="style.prev" variant="quiet" @tipAction=tipAction @onPress=prev>
        <span class="yh-display__style-name" data-part="style-name" title="Sunday Drive Pop">
          <AccentBlock as="button" chevron=false label="Sunday Drive Pop" name="Sunday Drive Pop: open the Browser" tip="browser.open" @tipAction=tipAction @onPress=browse>
        <Button name="Next style (Track right)" size="icon" symbol="next" tip="style.next" variant="quiet" @tipAction=tipAction @onPress=next>
        <span class="lib-text lib-tone yh-display__meta" data-part="meta" data-role="body" data-tabular="" data-text-size="label" title="Pop & Rock · 4/4">
          "Pop & Rock · 4/4"
      <div class="yh-display__ots" data-part="one-touch">
        <OneTouchPicker applied=2 count=4 @tipAction=tipAction @onApply=oneTouch>
    <div class="yh-display__readouts" data-part="readouts">
      <div aria-label="Section" class="yh-display__cell yh-display__section" data-part="section" role="group">
        <div aria-label="Playing Main B" class="yh-display__now" data-live="true" data-part="now" role="img">
          <SectionName idle=false label="Main B" size="var(--yh-display-section)">
        <p class="lib-text lib-tone yh-display__next" data-part="next" data-role="body" data-text-size="label">
          <span class="lib-text lib-tone yh-display__then" data-docked="true" data-part="then" data-role="body" data-text-size="label" style="--yh-display-then-hue: var(--accent)">
            <span aria-hidden="true" class="yh-display__then-arrow" data-part="then-arrow">
            <span class="yh-display__then-word" data-part="then-word">
