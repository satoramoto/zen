            <span class="lib-text lib-tone yh-display__then-name" data-part="then-name" data-role="body" data-text-leading="tight" data-text-weight="strong">
              "Main C"
            <span class="yh-display__when" data-part="when">
              "fill after bar 4"
      <div class="yh-display__cell yh-display__chord" data-part="chord">
        <ChordReadout chord="Am" extension="7" fingering="Fingered On Bass" held=false notes=[{"note":"A","interval":"R"},{"note":"C","interval":"m3"},{"note":"E","interval":"5"},{"note":"G","interval":"m7"}] size="var(--yh-display-chord)" tip="fingering.select" @tipAction=tipAction>
      <div aria-label="Tempo and Tap" class="yh-display__cell yh-display__tempo" data-part="tempo" role="group">
