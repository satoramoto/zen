  <span class="lib-text lib-tone lib-slider__caption" data-part="caption" data-role="body" data-text-case="label" data-text-size="caption">
    "Amount"
  <div class="lib-slider__frame">
    <div aria-label="Amount" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="70" aria-valuetext="70 %" class="lib-surface lib-slider__track lib-focus-ring" data-material="well" data-part="track" data-radius="pill" role="slider" tabindex="0" use:paramGesture={"param":{"kind":"float","min":0,"max":100,"defaultValue":50,"unit":"percent","name":"Amount"},"value":70,"disabled":false,"axis":"horizontal","travel":"element","mixed":false,"onChange":"change","onRelease":"release","onDepth":"depth","keyStep":"keyStep"}>
      <span aria-hidden="true" class="lib-slider__fill" data-part="fill">
      <span key=thumb aria-hidden="true" class="lib-surface lib-slider__thumb" data-material="handle" data-part="thumb" data-radius="pill">
  <span class="lib-text lib-tone lib-slider__readout" data-part="readout" data-role="numeral" data-text-size="label">
    "70 %"

## TypedAndLabelled
<div class="lib-slider" data-layout="row" data-length="auto" data-orientation="horizontal" style="--lib-param-chars: 5; --lib-param-fraction: 0.5; --lib-param-fill-start: 0.5; --lib-param-fill-size: 0; --lib-slider-length: auto" use:sliderEntry={"open":false,"disabled":false,"start":"0","onEntry":"entry","onCommit":"commit"}>
  <span class="lib-text lib-tone lib-slider__caption" data-part="caption" data-role="body" data-text-case="label" data-text-size="caption">
    "Speed"
  <div class="lib-slider__frame">
    <div aria-label="Speed" aria-orientation="horizontal" aria-valuemax="2" aria-valuemin="-2" aria-valuenow="0" aria-valuetext="0.00" class="lib-surface lib-slider__track lib-focus-ring" data-material="well" data-part="track" data-radius="pill" role="slider" tabindex="0" use:paramGesture={"param":{"kind":"float","min":-2,"max":2,"defaultValue":0,"steps":49,"name":"Speed"},"value":0,"disabled":false,"axis":"horizontal","travel":"element","mixed":false,"detents":[-2,-1,0,1,2],"snap":0.16666666666666666,"onChange":"change","onRelease":"release","onDepth":"depth","keyStep":"keyStep"}>
      <span aria-hidden="true" class="lib-slider__fill" data-part="fill">
      <span key=-2 aria-hidden="true" class="lib-slider__detent" data-part="detent" style="--lib-slider-detent: 0">
      <span key=-1 aria-hidden="true" class="lib-slider__detent" data-part="detent" style="--lib-slider-detent: 0.25">
      <span key=0 aria-hidden="true" class="lib-slider__detent" data-default="true" data-part="detent" style="--lib-slider-detent: 0.5">
      <span key=1 aria-hidden="true" class="lib-slider__detent" data-part="detent" style="--lib-slider-detent: 0.75">
      <span key=2 aria-hidden="true" class="lib-slider__detent" data-part="detent" style="--lib-slider-detent: 1">
      <span key=thumb aria-hidden="true" class="lib-surface lib-slider__thumb" data-material="handle" data-part="thumb" data-radius="pill">
  <button aria-label="Speed 0.00, type a value" class="lib-text lib-tone lib-slider__readout lib-slider__typed lib-focus-ring" data-part="readout" data-role="numeral" data-text-size="label" title="Type a value" type="button">
    "0.00"

