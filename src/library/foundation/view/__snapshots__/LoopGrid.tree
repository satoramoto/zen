      <button key=c2 aria-label="Keys slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="c" data-hue="3" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="keys" type="button" @click=cell:keys:c>
      <button key=c3 aria-label="Keys slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="d" data-hue="3" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="keys" type="button" @click=cell:keys:d>
