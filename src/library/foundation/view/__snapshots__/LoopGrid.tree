      <button key=c2 aria-label="Vox slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="c" data-hue="4" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="vox" type="button" @click=cell:vox:c>
      <button key=c3 aria-label="Vox slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="d" data-hue="4" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="vox" type="button" @click=cell:vox:d>
      <span key=c4 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
