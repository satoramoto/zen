      <button key=c0 aria-label="Perc Top, stopped" class="lib-surface yh-loopgrid__cell" data-cell="a" data-hue="1" data-material="key" data-part="cell" data-radius="control" data-state="stopped" data-track="perc" type="button" @click=cell:perc:a>
        <span class="lib-text lib-tone yh-loopgrid__cellname" data-part="cellname" data-role="caption">
