## Default
<div class="yh-loopgrid" data-form="full" data-part="root">
  <button key=open aria-expanded="false" aria-label="1 Open, folded" class="yh-loopgrid__song" data-part="song" data-song="open" type="button" @click=song:open>
    <span aria-hidden="true" class="yh-loopgrid__chevron" data-part="chevron">
      "▸"
    <span class="lib-text lib-tone yh-loopgrid__songname" data-part="songname" data-role="label" data-text-leading="tight">
      "1 Open"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="summary" data-role="caption" data-tone="muted">
      "■■□"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="songmeta" data-role="caption" data-tone="muted">
      "100 · Am"
  <button key=glass aria-expanded="false" aria-label="2 Glass, folded" class="yh-loopgrid__song" data-part="song" data-song="glass" type="button" @click=song:glass>
    <span aria-hidden="true" class="yh-loopgrid__chevron" data-part="chevron">
      "▸"
    <span class="lib-text lib-tone yh-loopgrid__songname" data-part="songname" data-role="label" data-text-leading="tight">
      "2 Glass"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="summary" data-role="caption" data-tone="muted">
      "■■■□"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="songmeta" data-role="caption" data-tone="muted">
      "104 · F"
  <button key=hidden aria-expanded="true" aria-label="3 Hidden Signals, open" class="yh-loopgrid__song" data-open="true" data-part="song" data-song="hidden" type="button" @click=song:hidden>
    <span aria-hidden="true" class="yh-loopgrid__chevron" data-part="chevron">
      "▾"
    <span class="lib-text lib-tone yh-loopgrid__songname" data-part="songname" data-role="label" data-text-leading="tight">
      "3 Hidden Signals"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="songmeta" data-role="caption" data-tone="muted">
      "112 · C"
  <button key=wire aria-expanded="false" aria-label="4 Wire, folded" class="yh-loopgrid__song" data-part="song" data-song="wire" type="button" @click=song:wire>
    <span aria-hidden="true" class="yh-loopgrid__chevron" data-part="chevron">
      "▸"
    <span class="lib-text lib-tone yh-loopgrid__songname" data-part="songname" data-role="label" data-text-leading="tight">
      "4 Wire"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="summary" data-role="caption" data-tone="muted">
      "■■□□"
    <span class="lib-text lib-tone yh-loopgrid__songmeta" data-part="songmeta" data-role="caption" data-tone="muted">
      "118 · G"
  <div key=thidden class="yh-loopgrid__columns" data-part="columns" data-song="hidden">
    <div key=drums class="yh-loopgrid__track" data-hue="1" data-part="track" data-track="drums">
      <button aria-label="select Drums" class="yh-loopgrid__trackhead" data-part="trackhead" type="button" @click=track:drums>
        <span aria-hidden="true" class="yh-loopgrid__mark" data-part="mark">
        <span class="lib-text lib-tone yh-loopgrid__trackname" data-part="trackname" data-role="label" data-text-leading="tight">
          "Drums"
      <button key=c0 aria-label="Drums Main, playing" class="lib-surface yh-loopgrid__cell" data-cell="a" data-hue="1" data-material="key" data-part="cell" data-radius="control" data-state="playing" data-track="drums" type="button" @click=cell:drums:a>
        <svg aria-hidden="true" class="yh-loopgrid__pie" data-part="pie" viewBox="0 0 10 10">
          <circle class="yh-loopgrid__track" cx="5" cy="5" r="4.5">
          <path class="yh-loopgrid__wedge" d="M 5 5 L 5 0 A 5 5 0 1 1 2.061073738537635 9.045084971874736 Z" data-hue="1">
        <span class="lib-text lib-tone yh-loopgrid__cellname" data-part="cellname" data-role="caption">
          "Main"
      <button key=c1 aria-label="Drums Break, stopped" class="lib-surface yh-loopgrid__cell" data-cell="b" data-hue="1" data-material="key" data-part="cell" data-radius="control" data-state="stopped" data-track="drums" type="button" @click=cell:drums:b>
        <span class="lib-text lib-tone yh-loopgrid__cellname" data-part="cellname" data-role="caption">
          "Break"
      <button key=c2 aria-label="Drums slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="c" data-hue="1" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="drums" type="button" @click=cell:drums:c>
      <button key=c3 aria-label="Drums slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="d" data-hue="1" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="drums" type="button" @click=cell:drums:d>
      <span key=c4 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
      <span key=c5 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
      <span key=c6 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
      <span key=c7 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
    <div key=bass class="yh-loopgrid__track" data-hue="2" data-part="track" data-track="bass">
      <button aria-label="select Bass" class="yh-loopgrid__trackhead" data-part="trackhead" type="button" @click=track:bass>
        <span aria-hidden="true" class="yh-loopgrid__mark" data-part="mark">
        <span class="lib-text lib-tone yh-loopgrid__trackname" data-part="trackname" data-role="label" data-text-leading="tight">
          "Bass"
      <button key=c0 aria-label="Bass Sub, playing" class="lib-surface yh-loopgrid__cell" data-cell="a" data-hue="2" data-material="key" data-part="cell" data-radius="control" data-state="playing" data-track="bass" type="button" @click=cell:bass:a>
        <svg aria-hidden="true" class="yh-loopgrid__pie" data-part="pie" viewBox="0 0 10 10">
          <circle class="yh-loopgrid__track" cx="5" cy="5" r="4.5">
          <path class="yh-loopgrid__wedge" d="M 5 5 L 5 0 A 5 5 0 1 1 2.061073738537635 9.045084971874736 Z" data-hue="2">
        <span class="lib-text lib-tone yh-loopgrid__cellname" data-part="cellname" data-role="caption">
          "Sub"
      <button key=c1 aria-label="Bass slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="b" data-hue="2" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="bass" type="button" @click=cell:bass:b>
      <button key=c2 aria-label="Bass slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="c" data-hue="2" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="bass" type="button" @click=cell:bass:c>
      <button key=c3 aria-label="Bass slot, empty" class="lib-surface yh-loopgrid__cell" data-cell="d" data-hue="2" data-material="key" data-part="cell" data-radius="control" data-state="empty" data-track="bass" type="button" @click=cell:bass:d>
      <span key=c4 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
      <span key=c5 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
      <span key=c6 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
      <span key=c7 aria-hidden="true" class="yh-loopgrid__cell yh-loopgrid__cell--hole" data-part="hole">
    <div key=keys class="yh-loopgrid__track" data-hue="3" data-part="track" data-selected="true" data-track="keys">
      <button aria-current="true" aria-label="select Keys" class="yh-loopgrid__trackhead" data-part="trackhead" data-selected="true" type="button" @click=track:keys>
        <span aria-hidden="true" class="yh-loopgrid__mark" data-part="mark">
        <span class="lib-text lib-tone yh-loopgrid__trackname" data-part="trackname" data-role="label" data-text-leading="tight">
          "Keys"
      <button key=c0 aria-label="Keys slot, recording" class="lib-surface yh-loopgrid__cell" data-cell="a" data-hue="3" data-material="key" data-part="cell" data-radius="control" data-state="recording" data-track="keys" type="button" @click=cell:keys:a>
        <svg aria-hidden="true" class="yh-loopgrid__pie" data-part="pie" viewBox="0 0 10 10">
          <circle class="yh-loopgrid__track" cx="5" cy="5" r="4.5">
          <path class="yh-loopgrid__wedge" d="M 5 5 L 5 0 A 5 5 0 0 1 9.755282581475768 6.545084971874736 Z" data-hue="3">
        <span class="lib-text lib-tone yh-loopgrid__cellname" data-part="bars" data-role="caption">
          "3"
      <button key=c1 aria-label="Keys Pad, stopped" class="lib-surface yh-loopgrid__cell" data-cell="b" data-hue="3" data-material="key" data-part="cell" data-radius="control" data-state="stopped" data-track="keys" type="button" @click=cell:keys:b>
        <span class="lib-text lib-tone yh-loopgrid__cellname" data-part="cellname" data-role="caption">
