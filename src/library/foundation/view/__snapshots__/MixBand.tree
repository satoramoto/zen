        "Drums"
    <Meter label="Drums meter" value=0.7>
    <Fader hue=1 kind="part" level=102 meter=0.7 name="Drums level" value="102" @onlevel=level:drums>
    <div class="yh-sendbars" data-form="bars" data-part="root">
      <div class="yh-sendbars__row" data-part="row" data-send="0">
