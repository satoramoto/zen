## Default
<div class="yh-mixband" data-form="tall" data-part="root">
  <div key=drums class="yh-mixband__strip" data-hue="1" data-part="strip" data-track="drums">
    <button aria-label="select Drums" class="yh-mixband__head" data-part="head" type="button" @click=select:drums>
      <span aria-hidden="true" class="yh-mixband__mark" data-part="mark">
      <span class="lib-text lib-tone yh-mixband__name" data-part="headname" data-role="label" data-text-leading="tight">
        "Drums"
    <Meter label="Drums meter" value=0.7>
    <Fader hue=1 kind="part" level=102 meter=0.7 name="Drums level" value="102" @onlevel=level:drums>
    <div class="yh-sendbars" data-form="bars" data-part="root">
      <div class="yh-sendbars__row" data-part="row" data-send="0">
        <span class="lib-text lib-tone yh-sendbars__label" data-part="label" data-role="caption" data-tone="muted">
          "A"
        <div aria-label="A send" aria-valuemax="1" aria-valuemin="0" aria-valuenow="0.4" aria-valuetext="40 percent" class="yh-sendbars__bar" data-hue="1" data-part="bar" role="slider" style="--yh-sendbars-at: 40%" tabindex="0" @pointerdown=tdrums:send0 @keydown=tdrums:send0>
          <span aria-hidden="true" class="yh-sendbars__track" data-part="track">
          <span aria-hidden="true" class="yh-sendbars__fill" data-part="fill">
          <span aria-hidden="true" class="yh-sendbars__hinge" data-part="hinge">
          <span aria-hidden="true" class="yh-sendbars__thumb" data-part="thumb">
      <div class="yh-sendbars__row" data-part="row" data-send="1">
        <span class="lib-text lib-tone yh-sendbars__label" data-part="label" data-role="caption" data-tone="muted">
          "B"
        <div aria-label="B send" aria-valuemax="1" aria-valuemin="0" aria-valuenow="0.75" aria-valuetext="75 percent, unity" class="yh-sendbars__bar" data-hue="1" data-part="bar" role="slider" style="--yh-sendbars-at: 75%" tabindex="0" @pointerdown=tdrums:send1 @keydown=tdrums:send1>
          <span aria-hidden="true" class="yh-sendbars__track" data-part="track">
          <span aria-hidden="true" class="yh-sendbars__fill" data-part="fill">
          <span aria-hidden="true" class="yh-sendbars__hinge" data-part="hinge">
          <span aria-hidden="true" class="yh-sendbars__thumb" data-part="thumb">
    <div class="yh-mixband__lamps" data-part="lamps">
      <LampButton label="M" name="Drums mute" @onToggle=mute:drums>
      <LampButton label="S" name="Drums solo" @onToggle=solo:drums>
      <LampButton label="Arm" name="Drums arm" rec=true @onToggle=arm:drums>
  <div key=bass class="yh-mixband__strip" data-hue="2" data-part="strip" data-track="bass">
