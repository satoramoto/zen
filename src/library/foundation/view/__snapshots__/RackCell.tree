## Board
<div class="yh-rack-cell">
  <button aria-label="Rack: Sunday drive, on Quick Rack A1. Opens the Rack page" class="yh-rack-cell__button lib-focus-ring" data-tip="nav.rack" type="button" @click=press>
    <span class="lib-text lib-tone yh-rack-cell__head" data-role="label" data-tabular="" data-text-size="caption">
      <span class="yh-rack-cell__label">
        "Rack"
      <span aria-hidden="true" class="yh-rack-cell__separator">
        "·"
      <span class="lib-text lib-tone yh-rack-cell__slot" data-role="label" data-tabular="" data-text-case="none">
        "A1"
    <span class="lib-text lib-tone yh-rack-cell__name" data-role="caption" data-tabular="" data-text-size="body">
      <span class="lib-text lib-tone yh-rack-cell__title" data-role="caption" data-tabular="" data-text-size="body">
        "Sunday drive"

