    <svg aria-hidden="true" class="lib-check__mark lib-check__dash" data-part="dash" viewBox="0 0 16 16">
      <rect fill="currentColor" height="2" rx="1" width="6.5" x="4.75" y="7">
  <span class="lib-check__label" data-part="label">
    {children}

## Mixed #10
<label class="lib-text lib-tone lib-check lib-radio lib-sized" data-disabled="" data-mixed="" data-part="root" data-role="body" data-size="xlarge">
  <span class="lib-check__box" data-part="box">
    <input class="lib-check__input" data-part="input" disabled="" type="radio" @change=change use:checkDefault={"checked":false,"mixed":false}>
    <span aria-hidden="true" class="lib-check__face" data-part="face">
    <span aria-hidden="true" class="lib-radio__dot" data-part="dot">
    <svg aria-hidden="true" class="lib-check__mark lib-check__dash" data-part="dash" viewBox="0 0 16 16">
      <rect fill="currentColor" height="2" rx="1" width="6.5" x="4.75" y="7">
  <span class="lib-check__label" data-part="label">
    {children}
