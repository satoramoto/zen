  <button key=cut aria-disabled="true" aria-label="CUT, hard cut" class="lib-surface yh-transitionrow__pad lib-focus-ring lib-press-ring" data-material="key" data-part="pad" data-radius="control" data-row-disabled="true" data-state="fired" type="button" @click=fire5>
