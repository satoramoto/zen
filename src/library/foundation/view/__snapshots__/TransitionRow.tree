  <button key=hold-b aria-disabled="true" aria-label="HOLD B, B section" class="lib-surface yh-transitionrow__pad lib-focus-ring lib-press-ring" data-hue="5" data-material="key" data-part="pad" data-radius="control" data-row-disabled="true" data-state="armed" type="button" @click=fire4>
