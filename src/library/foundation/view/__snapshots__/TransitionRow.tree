  <button key=hold-a aria-disabled="true" aria-label="HOLD A, A section" class="lib-surface yh-transitionrow__pad lib-focus-ring lib-press-ring" data-hue="4" data-material="key" data-part="pad" data-radius="control" data-row-disabled="true" data-state="fired" type="button" @click=fire3>
