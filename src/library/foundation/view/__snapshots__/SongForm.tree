## TransportPart
<div class="lib-text lib-tone yh-songform" data-form="keys" data-half="transport" data-part="root" data-role="body">
  <div class="lib-text lib-tone yh-songform__inner" data-part="inner" data-role="body">
    <div aria-label="Transport" class="yh-songform__transport" data-form="keys" data-part="transport" role="group">
      <div class="yh-songform__start" data-part="start">
        <Button hue="ok" label="Stop" name="Start / Stop, running (hold to stop with a fade)" pressed=true size="cell" tall=true tip="transport.start_stop" variant="secondary" @onPress=startStop @tipAction=tipAction>
      <div key=sync-start class="yh-songform__key" data-key="sync-start" data-part="key">
        <Button hue="role-2" label="Sync Start" lit=true name="Sync Start" pressed=false size="cell" tip="transport.sync_start" waiting=false @onPress=syncStart @tipAction=tipAction>
      <div key=sync-stop class="yh-songform__key" data-key="sync-stop" data-part="key">
        <Button hue="role-2" label="Sync Stop" pressed=false size="cell" tip="transport.sync_stop" waiting=false @onPress=syncStop @tipAction=tipAction>
      <div key=fill-up class="yh-songform__key" data-key="fill-up" data-part="key">
        <Button hue="role-2" label="Fill" lit=true name="Fill Up: a fill, then the next Main up" size="cell" symbol="up" tip="transport.fill_up" waiting=false @onPress=fillUp @tipAction=tipAction>
      <div key=fill-down class="yh-songform__key" data-key="fill-down" data-part="key">
        <Button hue="role-2" label="Fill" lit=true name="Fill Down: a fill, then the next Main down" size="cell" symbol="down" tip="transport.fill_down" waiting=false @onPress=fillDown @tipAction=tipAction>
      <div key=fade class="yh-songform__key" data-key="fade" data-part="key">
        <Button label="Fade" lit=true name="Fade out" pressed=false size="cell" tip="transport.fade" @onPress=fade @tipAction=tipAction>
      <div key=reset class="yh-songform__key" data-key="reset" data-part="key">
        <Button label="Reset" name="Section reset: restart the section from its first bar" size="cell" tip="transport.section_reset" @onPress=reset @tipAction=tipAction>
      <div key=accomp class="yh-songform__key" data-key="accomp" data-part="key">
        <LampButton label="Accomp" name="Accomp (ACMP)" on=true size="cell" tip="transport.acmp" @onToggle=accomp @tipAction=tipAction>
      <div key=auto-fill class="yh-songform__key" data-key="auto-fill" data-part="key">
        <LampButton hue="role-2" label="Auto Fill" on=false size="cell" tip="transport.auto_fill" @onToggle=autoFill @tipAction=tipAction>

