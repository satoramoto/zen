        <span class="lib-text lib-tone" data-part="label" data-role="label" data-text-leading="tight" data-truncate="">
          "Vocals"
      <div class="push-display__tab" data-col="5" data-icon="audio" data-row="bottom" style="--push-lamp: var(--push-lamp-17)">
        <span aria-label="audio track" class="lib-text lib-tone" data-part="icon" data-role="label" data-text-leading="tight" role="img">
          "∿"
        <span class="lib-text lib-tone" data-part="label" data-role="label" data-text-leading="tight" data-truncate="">
          "Guitar"
        <span aria-label="armed" class="push-display__armed" data-part="armed" role="img">
      <div class="push-display__tab" data-col="6" data-fold="open" data-icon="group" data-row="bottom" style="--push-lamp: var(--push-lamp-10)">
        <span aria-label="group" class="lib-text lib-tone" data-part="icon" data-role="label" data-text-leading="tight" role="img">
