          "LFO"
      <div class="push-display__tab" data-col="5" data-empty="true" data-row="top">
      <div class="push-display__tab" data-col="6" data-empty="true" data-row="top">
      <div class="push-display__tab" data-col="7" data-empty="true" data-row="top">
      <div class="push-display__tab" data-col="8" data-empty="true" data-row="top">
    <div class="push-display__body">
      <div class="push-display__cell" data-col="1" data-span="1" data-style="arc" data-type="param" style="grid-column: 1 / span 1; --push-lamp: var(--push-lamp-26)">
        <span class="lib-text lib-tone" data-part="name" data-role="label" data-text-leading="tight" data-truncate="">
          "Frequency"
        <div class="push-display__reading" data-part="reading">
          <span class="lib-text lib-tone" data-part="value" data-role="display" data-text-leading="tight">
            "20.0"
          <span class="lib-text lib-tone" data-part="unit" data-role="label" data-text-leading="tight">
            " kHz"
        <KnobReadout fraction=1 hue=1 label="" name="Frequency 20.0 kHz" unit="" value="" @onstep=turn:1>
      <div class="push-display__cell" data-col="2" data-span="1" data-style="bipolar" data-type="param" style="grid-column: 2 / span 1; --push-lamp: var(--push-lamp-26)">
        <span class="lib-text lib-tone" data-part="name" data-role="label" data-text-leading="tight" data-truncate="">
          "Pan"
        <div class="push-display__reading" data-part="reading">
          <span class="lib-text lib-tone" data-part="value" data-role="display" data-text-leading="tight">
            "C"
        <KnobReadout fraction=0.5 hue=1 label="" name="Pan C" origin="center" unit="" value="" @onstep=turn:2>
      <div class="push-display__cell" data-col="3" data-span="1" data-style="choice" data-type="param" style="grid-column: 3 / span 1; --push-lamp: var(--push-lamp-26)">
        <span class="lib-text lib-tone" data-part="name" data-role="caption" data-text-leading="tight" data-text-weight="strong" data-truncate="">
          "Type"
        <FolderList chosen="2" items=[{"id":"0","label":"Low-pass"},{"id":"1","label":"High-pass"},{"id":"2","label":"Band-pass"},{"id":"3","label":"Notch"}] label="Type Band-pass">
      <div class="push-display__cell" data-col="4" data-span="1" data-style="switch" data-type="param" style="grid-column: 4 / span 1; --push-lamp: var(--push-lamp-26)">
        <Toggle ink="var(--push-lit)" label="Retrig On" layout="stacked" name="Retrig" on=true @onChange=switch:4>
          #children
            "On"
      <div class="push-display__cell" data-col="5" data-span="1" data-style="bar" data-type="param" style="grid-column: 5 / span 1; --push-lamp: var(--push-lamp-26)">
        <Slider display="-6.0 dB" ink="var(--push-lit)" label="Level -6.0 dB" layout="stacked" length="auto" name="Level" orientation="horizontal" param={"kind":"float","min":0,"max":1,"defaultValue":0} showValue=true value=0.75 @onChange=none>
      <div class="push-display__cell" data-col="6" data-span="1" data-style="arc" data-touched="true" data-type="param" style="grid-column: 6 / span 1; --push-lamp: var(--push-lamp-26)">
        <span class="lib-text lib-tone" data-part="name" data-role="label" data-text-leading="tight" data-truncate="">
