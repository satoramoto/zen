      <div class="push-display__tab" data-col="8" data-empty="true" data-row="top">
    <div class="push-display__body">
      <div class="push-display__cell" data-col="1" data-span="1" data-style="bipolar" data-type="param" style="grid-column: 1 / span 1; --push-lamp: var(--push-lamp-20)">
        <span class="lib-text lib-tone" data-part="name" data-role="label" data-text-leading="tight" data-truncate="">
          "Octave"
        <div class="push-display__reading" data-part="reading">
          <span class="lib-text lib-tone" data-part="value" data-role="display" data-text-leading="tight">
            "0"
        <KnobReadout fraction=0.5 hue=1 label="" name="Octave 0" origin="center" unit="" value="" @onstep=turn:1>
      <div class="push-display__cell" data-col="2" data-span="4" data-type="trace" style="grid-column: 2 / span 4; --push-lamp: var(--push-lamp-20)">
        <PushTrace fill=false hue=1 markers=[] name="Oscillator shape" points=[[0,0],[0.03125,0.0625],[0.0625,0.125],[0.09375,0.1875],[0.125,0.25],[0.15625,0.3125],[0.1875,0.375],[0.21875,0.4375],[0.25,0.5],[0.28125,0.5625],[0.3125,0.625],[0.34375,0.6875],[0.375,0.75],[0.40625,0.8125],[0.4375,0.875],[0.46875,0.9375],[0.5,0],[0.53125,0.0625],[0.5625,0.125],[0.59375,0.1875],[0.625,0.25],[0.65625,0.3125],[0.6875,0.375],[0.71875,0.4375],[0.75,0.5],[0.78125,0.5625],[0.8125,0.625],[0.84375,0.6875],[0.875,0.75],[0.90625,0.8125],[0.9375,0.875],[0.96875,0.9375],[1,0]]>
      <div class="push-display__cell" data-col="6" data-span="1" data-style="arc" data-type="param" style="grid-column: 6 / span 1; --push-lamp: var(--push-lamp-20)">
        <span class="lib-text lib-tone" data-part="name" data-role="label" data-text-leading="tight" data-truncate="">
          "Noise"
        <div class="push-display__reading" data-part="reading">
          <span class="lib-text lib-tone" data-part="value" data-role="display" data-text-leading="tight">
            "10"
          <span class="lib-text lib-tone" data-part="unit" data-role="label" data-text-leading="tight">
            "%"
        <KnobReadout fraction=0.1 hue=1 label="" name="Noise 10 %" unit="" value="" @onstep=turn:6>
      <div class="push-display__cell" data-col="7" data-span="1" data-style="arc" data-type="param" style="grid-column: 7 / span 1; --push-lamp: var(--push-lamp-20)">
        <span class="lib-text lib-tone" data-part="name" data-role="label" data-text-leading="tight" data-truncate="">
