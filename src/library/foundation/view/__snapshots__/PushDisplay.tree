        <span class="lib-text lib-tone" data-part="label" data-role="label" data-text-leading="tight" data-truncate="">
          "Synths"
      <div class="push-display__tab" data-col="7" data-icon="return" data-row="bottom" style="--push-lamp: var(--push-lamp-36)">
        <span aria-label="return" class="lib-text lib-tone" data-part="icon" data-role="label" data-text-leading="tight" role="img">
