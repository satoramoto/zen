  <div class="push-display__screen">
    <div class="push-display__row" data-row="top">
      <div class="push-display__tab" data-col="1" data-row="top" data-selected="true" style="--push-lamp: var(--push-lamp-20)">
        <span class="lib-text lib-tone" data-part="label" data-role="label" data-text-leading="tight" data-truncate="">
          "Oscillator"
      <div class="push-display__tab" data-col="2" data-row="top" style="--push-lamp: var(--push-lamp-20)">
        <span class="lib-text lib-tone" data-part="label" data-role="label" data-text-leading="tight" data-truncate="">
          "Filter"
      <div class="push-display__tab" data-col="3" data-empty="true" data-row="top">
      <div class="push-display__tab" data-col="4" data-empty="true" data-row="top">
      <div class="push-display__tab" data-col="5" data-empty="true" data-row="top">
      <div class="push-display__tab" data-col="6" data-empty="true" data-row="top">
