        <Pad family="util" fillCell=true index="9" label="Manual Bass" lit=true onFace="ring" state="idle" @onPress=press8 @tipAction=tipAction>
      <div key=9 class="yh-padbank__cell" data-part="cell">
        <Pad family="util" fillCell=true index="10" label="Stop ACMP" lit=true onFace="ring" state="idle" @onPress=press9 @tipAction=tipAction>
