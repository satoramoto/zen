        <Pad family="util" fillCell=true index="15" label="Transp 0" lit=true onFace="ring" state="idle" @onPress=press14 @tipAction=tipAction>
      <div key=15 class="yh-padbank__cell" data-part="cell">
        <Pad family="util" fillCell=true index="16" label="Retrig­ger" lit=true name="Retrigger (pad 16)" onFace="ring" state="idle" @onPress=press15 @tipAction=tipAction>

