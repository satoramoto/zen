## Playground
<label class="lib-text lib-tone lib-check lib-checkbox lib-sized" data-part="root" data-role="body" data-size="regular">
  <span class="lib-check__box" data-part="box">
    <input class="lib-check__input" data-part="input" type="checkbox" @change=change use:checkDefault={"checked":false,"mixed":false}>
    <span aria-hidden="true" class="lib-check__face" data-part="face">
    <svg aria-hidden="true" class="lib-check__mark lib-check__check" data-part="check" viewBox="0 0 16 16">
      <path d="M4.6 8.4 7 10.75 11.4 5.3" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" stroke="currentColor">
    <svg aria-hidden="true" class="lib-check__mark lib-check__dash" data-part="dash" viewBox="0 0 16 16">
      <rect fill="currentColor" height="2" rx="1" width="6.5" x="4.75" y="7">
  <span class="lib-check__label" data-part="label">
    {children}

