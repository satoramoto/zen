      <button aria-label="Master: open Effects, master compressor and EQ" class="lib-text lib-tone yh-faderbank__name" data-role="body" data-text-leading="snug" data-text-size="inherit" data-tip="fx.master_edit" type="button" @click=open:master use:tip={"tip":"fx.master_edit","tipAction":"tipAction"}>
