          "Right 1"
        <span class="lib-text lib-tone yh-faderbank__sound" data-role="body" data-text-leading="snug" data-text-size="caption">
          "Stage Grand"
        <span class="yh-faderbank__marks">
          <PartMarks off=false size="strip">
    <div key=strip:right2 class="lib-stack yh-faderbank__strip" data-away="up" data-direction="column" data-gap="1" data-hue="2" data-kind="part" style="grid-column: 2">
      <Fader away=50 empty=false fillHeight=true hue=2 kind="part" layered=false level=72 meter2=0.42 meter=0.45 name="Right 2 · Silk Strings, level 72, hardware fader away (soft takeover)" peak=0.55 tip="mixer.panel.right2" value="72" @tipAction=tipAction @onlevel=level:right2>
      <button aria-label="Right 2, Silk Strings, edited: open Channel" class="lib-text lib-tone yh-faderbank__name" data-role="body" data-text-leading="snug" data-text-size="inherit" data-tip="mixer.strip.select" type="button" @click=open:right2 use:tip={"tip":"mixer.strip.select","tipAction":"tipAction"}>
        <span class="lib-text lib-tone yh-faderbank__tag-text" data-role="body" data-text-leading="snug" data-text-size="label" data-text-weight="strong">
          "Right 2"
        <span class="lib-text lib-tone yh-faderbank__sound" data-role="body" data-text-leading="snug" data-text-size="caption">
          "Silk Strings"
        <span class="yh-faderbank__marks">
          <PartMarks edited=true off=false size="strip">
    <div key=strip:right3 class="lib-stack yh-faderbank__strip" data-direction="column" data-gap="1" data-hue="3" data-kind="off" style="grid-column: 3">
      <Fader empty=false fillHeight=true hue=3 kind="off" layered=false level=64 meter2=0 meter=0 name="Right 3 · Brass Section, level 64, off" peak=0 tip="mixer.panel.right3" value="64" @tipAction=tipAction @onlevel=level:right3>
      <button aria-label="Right 3, Brass Section, plugin missing: open Channel" class="lib-text lib-tone yh-faderbank__name" data-role="body" data-text-leading="snug" data-text-size="inherit" data-tip="mixer.strip.select" type="button" @click=open:right3 use:tip={"tip":"mixer.strip.select","tipAction":"tipAction"}>
        <span class="lib-text lib-tone yh-faderbank__tag-text" data-role="body" data-text-leading="snug" data-text-size="label" data-text-weight="strong">
          "Right 3"
        <span class="lib-text lib-tone yh-faderbank__sound" data-role="body" data-text-leading="snug" data-text-size="caption">
