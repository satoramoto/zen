    <div key=cell:left class="yh-faderbank__lamp" style="grid-column: 4">
      <LampButton key=lamp:left hue=4 label="On" name="Left on. Long press: swap mode (knobs edit this part). Shift: open Channel" on=true size="cell" tip="part.left.on" @tipAction=tipAction @onToggle=lamp:left @onLongPress=lampLong:left @onLongRelease=lampRelease:left>
    <div key=page class="yh-faderbank__lamp yh-faderbank__lamp--page" style="grid-column: 11">
      <Button label="Panel" name="Fader page is Panel: click for Style" size="cell" tip="mixer.page" @tipAction=tipAction @onPress=page>
  <div class="yh-faderbank__foot">
    <Group class="yh-faderbank__functions" className="yh-faderbank__functions" gap=3 label=false name="Functions">
      #children
        <LampButton key=lamp:harmArp hue="t" label="Harm/Arp" name="Harmony/Arpeggio on/off" on=false size="cell" tip="harmony.switch" @tipAction=tipAction @onToggle=lamp:harmArp>
        <LampButton key=lamp:sound hue="t" label="Sound" name="Sound: hold and the pads become Quick Racks. A click latches it until the next pad tap; click again or press fader button 6 to close" on=true size="cell" tip="launchkey.sound" @tipAction=tipAction @onToggle=lamp:sound @onLongPress=lampLong:sound @onLongRelease=lampRelease:sound>
        <LampButton key=lamp:leftHold hue="t" label="L Hold" name="Left Hold on/off" on=false size="cell" tip="detection.left_hold" @tipAction=tipAction @onToggle=lamp:leftHold>
        <LampButton key=lamp:looper hue="t" label="Looper" name="Chord Looper on/off. Long press: Loop rec" on=false size="cell" tip="looper.rec" @tipAction=tipAction @onToggle=lamp:looper @onLongPress=lampLong:looper @onLongRelease=lampRelease:looper>
  <span class="yh-faderbank__takeover yh-faderbank__visually-hidden" role="status">
    "Soft takeover "
    <span>
      "Right 2 move up to 72"

