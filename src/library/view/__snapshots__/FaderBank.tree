  <div class="yh-faderbank__grid" style="grid-template-columns: minmax(min-content, 1fr) minmax(min-content, 1fr) minmax(min-content, 1fr) minmax(min-content, 1fr) var(--space-1) minmax(min-content, 1fr) minmax(min-content, 1fr) minmax(var(--space-4), 0.75fr) minmax(var(--space-4), 0.75fr) var(--space-1) minmax(min-content, 1.25fr)">
