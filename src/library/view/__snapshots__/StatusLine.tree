## Error
<p aria-live="polite" class="lib-text lib-tone yh-status-line" data-part="root" data-role="body" data-tabular="" role="status" style="width: 1392px">
  <button class="yh-status-line-button" data-part="button" data-tip="display.status" type="button" @click=clear>
    <span key=tag-4 aria-hidden="true" class="lib-text lib-tone yh-status-line-tag" data-part="tag" data-role="label" data-tabular="" data-text-leading="tight">
      <svg class="yh-status-line-mark" data-hue="warn" data-part="mark" height="12" viewBox="0 0 12 12" width="12">
        <path d="M6 1.5 L11 10.5 H1 Z">
        <path d="M6 5 V7.4">
        <circle cx="6" cy="8.9" r="0.6">
      "Error"
    <span key=text-4 class="yh-status-line-text" data-part="text">
      <span class="yh-status-line-hidden" data-part="hidden">
        "Error:"
      " Can't delete Sunday drive: it's the loaded rack."
    <svg aria-hidden="true" class="yh-status-line-clear" data-part="clear" height="10" viewBox="0 0 10 10" width="10">
      <path d="M2 2 L8 8 M8 2 L2 8">

