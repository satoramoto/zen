## Hint
<p aria-live="polite" class="lib-text lib-tone yh-status-line" data-part="root" data-role="body" data-tabular="" role="status" style="width: 1392px">
  <span aria-hidden="true" class="yh-status-line-hint" data-part="hint">
    <span class="lib-text lib-tone yh-status-line-hint-title" data-part="hint-title" data-role="body" data-tabular="" data-text-weight="strong">
      "Sync Start"
    <span class="yh-status-line-hint-body" data-part="hint-body">
      "Arms the band to start on the first chord you play with your left hand."
    <span class="yh-status-line-hint-meta" data-part="hint-meta">
      <span key=Key class="yh-status-line-hint-place" data-part="hint-place">
        <span class="lib-text lib-tone yh-status-line-hint-label" data-part="hint-label" data-role="caption" data-tabular="" data-text-case="label">
          "Key"
        " "
        <kbd class="lib-text lib-tone yh-status-line-key" data-part="key" data-role="caption" data-tabular="">
          "Y"
      <span key=Launchkey class="yh-status-line-hint-place" data-part="hint-place">
        <span class="lib-text lib-tone yh-status-line-hint-label" data-part="hint-label" data-role="caption" data-tabular="" data-text-case="label">
          "Launchkey"
        " "
        <kbd class="lib-text lib-tone yh-status-line-key" data-part="key" data-role="caption" data-tabular="">
          "Shift + Play"

