## Default
<div aria-label="Stem lanes" class="lib-surface yh-stemlanes" data-form="four" data-layer="raised" data-part="root" data-radius="card" role="group" style="--yh-stem-ruler-h: var(--control-h); --yh-stem-lane-h: calc(var(--control-h) * 1.25); --yh-stem-mark-w: var(--space-1); --yh-stem-name-w: calc(var(--space-6) * 1.5); --yh-stem-keys-w: calc(var(--control-h) * 4); --yh-stem-pad: var(--space-2); --yh-stem-gap: var(--space-1)">
