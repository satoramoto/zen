      <button key=cue:drop aria-label="Cue Drop" class="yh-stemlanes__cue lib-focus-ring" data-cue="drop" data-part="cue" disabled="" style="--yh-stem-at: 0.58" type="button" @click=cue:drop>
        <span class="lib-text lib-tone yh-stemlanes__cue-label" data-part="label" data-role="caption" data-text-case="label" data-text-leading="tight">
          "Drop"
