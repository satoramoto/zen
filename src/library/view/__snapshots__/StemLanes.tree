    <span class="yh-stemlanes__track" data-part="track">
      <span aria-hidden="true" class="yh-stemlanes__window" data-part="window" style="--yh-stem-start: 0.18; --yh-stem-end: 0.74">
      <span aria-hidden="true" class="yh-stemlanes__playhead" data-part="playhead" style="--yh-stem-position: 0.62">
      <button key=cue:intro aria-label="Cue Intro" class="yh-stemlanes__cue lib-focus-ring" data-cue="intro" data-part="cue" disabled="" style="--yh-stem-at: 0.03" type="button" @click=cue:intro>
        <span class="lib-text lib-tone yh-stemlanes__cue-label" data-part="label" data-role="caption" data-text-case="label" data-text-leading="tight">
