## Board
<div class="yh-sound-cell" data-hue="1">
  <button aria-label="Right 1: open Channel" class="lib-text lib-tone yh-sound-cell__part lib-focus-ring" data-role="label" data-tabular="" title="Right 1" type="button" @click=part>
    "R1"
  <button aria-label="Right 1 sound: 1 Stage Grand. Opens the quick sound list" class="lib-text lib-tone yh-sound-cell__sound lib-focus-ring" data-role="caption" data-tabular="" data-text-size="body" type="button" @click=sound>
    <span class="yh-sound-cell__title">
      "Stage Grand"
    <span class="lib-text lib-tone yh-sound-cell__number" data-role="caption" data-tabular="">
      "1"

