    #region:bar
      <AppBar bufferFrames=256 chosen="stage" cpu=0.2 displayTabs=[{"id":"stage","label":"Stage","tip":"view.stage"},{"id":"channel","label":"Channel","tip":"nav.channel"},{"id":"effects","label":"Effects","tip":"nav.effects"},{"id":"quickRacks","label":"Quick Racks","tip":"nav.quick"},{"id":"multiPads","label":"Multi Pads","tip":"nav.multipad"},{"id":"looper","label":"Looper","tip":"nav.looper"},{"id":"harmArp","label":"Harm/Arp","tip":"nav.harmony"}] dropouts=0 failedPart=null fullTabs=[{"id":"library","label":"Library","tip":"view.library"},{"id":"settings","label":"Settings","tip":"nav.settings"}] help=false launchkey=true metronome=false metronomeOpen=false synthOn=true unison=false>
    #region:hero
      <Region name="Hero">
        #children
          <Display nowPlaying={"playing":"Main B","next":"Main C","fill":"fill after bar 4","bar":3,"bars":4,"bpm":104,"running":true,"syncStart":false,"chord":{"chord":"Am","extension":"7","notes":[{"note":"A","interval":"R"},{"note":"C","interval":"m3"},{"note":"E","interval":"5"},{"note":"G","interval":"m7"}],"fingering":"Fingered On Bass","held":false},"beat":2,"beats":4,"styleTempo":104} style={"name":"Sunday Drive Pop","category":"Pop & Rock","timeSignature":"4/4","queued":"","oneTouch":2,"oneTouchCount":4} @onTap=tap>
    #region:transport
      <Region name="Transport">
        #children
          <SongForm absent=["intro3","ending3"] accomp=true autoFill=false fading=false next="mainC" nextAt="after bar 4" part="transport" playing="mainB" running=true syncStart=false syncStop=false>
    #region:mixer
      <FaderBankRegion functionLamps=[{"id":"harmArp","label":"Harm/Arp","on":false,"hue":"t","tip":"harmony.switch","name":"Harmony/Arpeggio on/off"},{"id":"sound","label":"Sound","on":true,"hue":"t","long":true,"tip":"launchkey.sound","name":"Sound: hold and the pads become Quick Racks. A click latches it until the next pad tap; click again or press fader button 6 to close"},{"id":"leftHold","label":"L Hold","on":false,"hue":"t","tip":"detection.left_hold","name":"Left Hold on/off"},{"id":"looper","label":"Looper","on":false,"hue":"t","long":true,"tip":"looper.rec","name":"Chord Looper on/off. Long press: Loop rec"}] layer="volume" layerTabs=[{"id":"volume","label":"Vol","name":"Volume","tip":"mixer.layer"},{"id":"pan","label":"Pan","tip":"mixer.layer"},{"id":"reverb","label":"Reverb","name":"Reverb send","tip":"mixer.layer"},{"id":"chorus","label":"Chorus","name":"Chorus send","tip":"mixer.layer"},{"id":"delay","label":"Delay","name":"Delay send","tip":"mixer.layer"}] page="panel" pageTabs=[{"id":"panel","label":"Panel","tip":"mixer.page"},{"id":"style","label":"Style","tip":"mixer.page"}] partLamps=[{"id":"right1","label":"On","on":true,"hue":"r1","long":true,"tip":"part.right1.on","name":"Right 1 on. Long press: swap mode (knobs edit this part). Shift: open Channel"},{"id":"right2","label":"On","on":true,"hue":"r2","long":true,"tip":"part.right2.on","name":"Right 2 on. Long press: swap mode (knobs edit this part). Shift: open Channel"},{"id":"right3","label":"Off","on":false,"hue":"r3","long":true,"tip":"part.right3.on","name":"Right 3 off. Long press: swap mode (knobs edit this part). Shift: open Channel"},{"id":"left","label":"On","on":true,"hue":"l","long":true,"tip":"part.left.on","name":"Left on. Long press: swap mode (knobs edit this part). Shift: open Channel"}] strips=[{"id":"right1","tag":"Right 1","hue":"r1","kind":"part","value":"90","level":90,"meter":0.62,"meter2":0.58,"peak":0.7,"sound":"Stage Grand","faderName":"Right 1 · Stage Grand, level 90","openName":"Right 1, Stage Grand: open Channel","tip":"mixer.panel.right1","openTip":"mixer.strip.select"},{"id":"right2","tag":"Right 2","hue":"r2","kind":"part","value":"72","level":72,"meter":0.45,"meter2":0.42,"peak":0.55,"away":50,"edited":true,"sound":"Silk Strings","faderName":"Right 2 · Silk Strings, level 72, hardware fader away (soft takeover)","openName":"Right 2, Silk Strings, edited: open Channel","tip":"mixer.panel.right2","openTip":"mixer.strip.select"},{"id":"right3","tag":"Right 3","hue":"r3","kind":"off","value":"64","level":64,"meter":0,"meter2":0,"peak":0,"missing":true,"sound":"Brass Section","faderName":"Right 3 · Brass Section, level 64, off","openName":"Right 3, Brass Section, plugin missing: open Channel","tip":"mixer.panel.right3","openTip":"mixer.strip.select"},{"id":"left","tag":"Left","hue":"l","kind":"part","value":"80","level":80,"meter":0.5,"meter2":0.47,"peak":0.6,"sound":"Finger Bass","faderName":"Left · Finger Bass, level 80","openName":"Left, Finger Bass: open Channel","tip":"mixer.panel.left","openTip":"mixer.strip.select"},{"id":"style","tag":"Style","hue":"a","kind":"group","value":"100","level":100,"meter":0.7,"meter2":0.65,"peak":0.78,"faderName":"Style volume, level 100","openName":"Style volume: open the Style fader page","tip":"mixer.style_level","openTip":"mixer.page"},{"id":"multiPad","tag":"Multi Pad","hue":"t2","kind":"group","value":"90","level":90,"meter":0,"meter2":0,"peak":0.12,"faderName":"Multi Pad volume, level 90","openName":"Multi Pad volume: open Multi Pads","tip":"mixer.pad_level","openTip":"nav.multipad"},{"id":"fader7","tag":"—","hue":"t","kind":"parked","value":"","level":0,"meter":0,"meter2":0,"peak":0,"faderName":"Fader 7 unused","tip":"launchkey.fader_unused"},{"id":"fader8","tag":"—","hue":"t","kind":"parked","value":"","level":0,"meter":0,"meter2":0,"peak":0,"faderName":"Fader 8 unused","tip":"launchkey.fader_unused"},{"id":"master","tag":"Master","hue":"t","kind":"master","value":"100","level":100,"m