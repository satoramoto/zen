      <span class="yh-lineslider__fill" data-part="fill" style="width: 33.33333333333333%">
      <span class="yh-lineslider__thumb" data-part="thumb" style="left: 33.33333333333333%">
  <span aria-hidden="true" class="yh-lineslider__readout" data-part="readout">
    <span class="lib-text lib-tone yh-lineslider__value" data-part="value" data-role="numeral" style="min-width: 2ch">
      "10"
    <span class="lib-text lib-tone yh-lineslider__unit" data-part="unit" data-role="caption" data-text-leading="tight">
      "ms"

