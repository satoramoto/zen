## Board
<span class="yh-lineslider" data-part="root">
  <span aria-label="Chord settle" aria-valuemax="30" aria-valuemin="0" aria-valuenow="10" aria-valuetext="10 ms" class="yh-lineslider__hit lib-focus-ring" data-part="slider" data-tip="settings.chord_settle" role="slider" style="width: 160px" tabindex="0" use:lineSlider={"value":10,"min":0,"max":30,"step":1,"disabled":false,"onchange":"change"} use:tip={"tip":"settings.chord_settle","tipAction":"tipAction"}>
