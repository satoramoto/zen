{
  "compilerOptions": {
    "target":"ES2022", "lib":["ES2022","DOM","DOM.Iterable"],
    "module":"ESNext", "moduleResolution":"Bundler", "jsx":"react-jsx",
    "strict":true, "noEmit":true, "skipLibCheck":true,
    "esModuleInterop":true, "resolveJsonModule":true,
    "types":["vite/client","node"]
  },
  "include":["src","scripts",".storybook","vite.config.ts","vitest.config.ts"],
  // The Claude Code harness's engine-JSX files are their own project (src/harness/claude-code/tsconfig.json).
  "exclude":["src/harness/claude-code/kit","src/harness/claude-code/sample","src/harness/claude-code/stories","src/harness/claude-code/bench","src/harness/claude-code/engine.d.ts"]
}
