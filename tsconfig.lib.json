{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/library",
    "outDir": "lib",
    "types": ["vite/client"]
  },
  "include": ["src/library/index.ts", "src/library/storybook.tsx", "src/library/svelte.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"]
}
