{
  "name": "@satoramoto/zen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./astro": { "types": "./src/site/astro.d.mts", "import": "./src/site/astro.mjs" },
    "./site": {
      "zen-source": "./src/library/site/index.ts",
      "types": "./lib/site/index.d.ts",
      "import": "./lib/site.js"
    },
    ".": {
      "zen-source": "./src/library/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./zen.css": {
      "zen-source": "./src/library/source.css",
      "default": "./lib/zen.css"
    },
    "./storybook": {
      "zen-source": "./src/library/storybook.tsx",
      "types": "./lib/storybook.d.ts",
      "import": "./lib/storybook.js"
    },
    "./svelte": {
      "zen-source": "./src/library/svelte.ts",
      "types": "./lib/svelte.d.ts",
      "import": "./lib/svelte.js"
    },
    "./themes": {
      "zen-source": "./src/library/themes.ts",
      "types": "./lib/themes.d.ts",
      "import": "./lib/themes.js"
    },
    "./compendium": {
      "zen-source": "./src/library/compendium/index.ts",
      "types": "./lib/compendium/index.d.ts",
      "import": "./lib/compendium.js"
    },
    "./compendium/model": {
      "zen-source": "./src/library/compendium/model/index.ts",
      "types": "./lib/compendium/model/index.d.ts",
      "import": "./lib/compendium-model.js"
    },
    "./math/trig": {
      "zen-source": "./src/library/math/trig/index.ts",
      "types": "./lib/math/trig/index.d.ts",
      "import": "./lib/math-trig.js"
    },
    "./math/trig/model": {
      "zen-source": "./src/library/math/trig/model/index.ts",
      "types": "./lib/math/trig/model/index.d.ts",
      "import": "./lib/math-trig-model.js"
    },
    "./math/expression": {
      "zen-source": "./src/library/math/calculator/public.ts",
      "types": "./lib/math/calculator/public.d.ts",
      "import": "./lib/math-expression.js"
    },
    "./harness/*": "./src/harness/*",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "src/site",
    "src/harness"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "check:lib": "tsx scripts/check-lib-entries.ts",
    "build:site-fixture": "astro build --root fixtures/site",
    "check:site": "node --test src/site/content.check.mjs && npm run build:site-fixture && node scripts/check-site.mjs",
    "prepare": "npm run build:lib",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/harness/claude-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:music:stories": "node scripts/music-stories.mjs",
    "test:music:visual": "node scripts/music-visual.mjs",
    "test:music:themes": "node scripts/music-theme-switch.mjs",
    "test:music:hooks": "vitest run src/library/Music",
    "tiers": "tsx scripts/tiers.ts",
    "build": "tsc --noEmit && vite build",
    "build:storybook": "node scripts/build-storybook.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.1.0",
    "astro": "^7.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "@astrojs/react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/react": "7.1.5",
    "@fontsource-variable/recursive": "5.3.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.139.0",
    "@vitejs/plugin-react": "6.1.2",
    "astro": "7.4.8",
    "jsdom": "30.1.2",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "svelte": "5.57.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "story-spec": "github:satoramoto/story-spec#1227aaebc5a33adc817be3451a9c491476cfd5ae",
    "@cortex-js/compute-engine": "0.182.0",
    "mafs": "0.21.0",
    "marked": "18.2.0",
    "mathbox": "2.3.2-rc1",
    "mathlive": "0.111.4",
    "temml": "0.14.0",
    "three": "0.139.2"
  },
  "overrides": {
    "use-resize-observer": "10.0.0"
  }
}
