{
  "name": "@satoramoto/zen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "zen-source": "./src/library/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./zen.css": {
      "zen-source": "./src/library/source.css",
      "default": "./lib/zen.css"
    },
    "./storybook": {
      "zen-source": "./src/library/storybook.tsx",
      "types": "./lib/storybook.d.ts",
      "import": "./lib/storybook.js"
    },
    "./svelte": {
      "zen-source": "./src/library/svelte.ts",
      "types": "./lib/svelte.d.ts",
      "import": "./lib/svelte.js"
    },
    "./themes": {
      "zen-source": "./src/library/themes.ts",
      "types": "./lib/themes.d.ts",
      "import": "./lib/themes.js"
    },
    "./harness/*": "./src/harness/*",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "src/harness"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "check:lib": "tsx scripts/check-lib-entries.ts",
    "prepare": "npm run build:lib",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/harness/claude-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:music:stories": "node scripts/music-stories.mjs",
    "test:music:visual": "node scripts/music-visual.mjs",
    "test:music:themes": "node scripts/music-theme-switch.mjs",
    "test:music:hooks": "vitest run src/library/Music",
    "tiers": "tsx scripts/tiers.ts",
    "build": "tsc --noEmit && vite build",
    "build:storybook": "storybook build --disable-telemetry"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "svelte": "5.57.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
