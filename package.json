{
  "name": "@satoramoto/zen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "zen-source": "./src/library/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./zen.css": {
      "zen-source": "./src/library/source.css",
      "default": "./lib/zen.css"
    },
    "./storybook": {
      "zen-source": "./src/library/storybook.tsx",
      "types": "./lib/storybook.d.ts",
      "import": "./lib/storybook.js"
    },
    "./visuals": {
      "zen-source": "./src/library/visuals/index.ts",
      "types": "./lib/visuals/index.d.ts",
      "import": "./lib/visuals.js"
    },
    "./visuals.css": {
      "zen-source": "./src/library/source.css",
      "default": "./lib/visuals.css"
    },
    "./visuals/lab": {
      "zen-source": "./src/library/visuals/lab.ts",
      "types": "./lib/visuals/lab.d.ts",
      "import": "./lib/visuals-lab.js"
    },
    "./visuals-lab.css": {
      "zen-source": "./src/library/source.css",
      "default": "./lib/visuals-lab.css"
    }
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tiers": "tsx scripts/tiers.ts",
    "build": "tsc --noEmit && vite build",
    "build:storybook": "storybook build --disable-telemetry"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
